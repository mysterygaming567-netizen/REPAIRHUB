{
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/",
        "destination": "/index/index.html",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}